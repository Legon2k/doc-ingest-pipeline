{
  "manifest_version": 3,
  "name": "Resume Tailor Helper",
  "version": "1.0.0",
  "description": "Быстрая отправка адаптированного резюме из буфера обмена в локальный FastAPI сервис.",
  "permissions": [
    "clipboardRead",
    "clipboardWrite",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Resume Tailor"
  }
}